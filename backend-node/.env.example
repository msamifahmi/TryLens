# Salin ke .env lalu isi (server membaca variabel lingkungan; gunakan `node --env-file=.env server.js` di Node 20.6+).
PORT=4000
NODE_ENV=development
# SQLite: berkas basis data & folder unggahan (foto + .glb Mitra)
DB_PATH=./data/trylens.db
UPLOADS_DIR=./uploads
# Asal front-end lintas-origin (pisahkan koma). Kosong bila memakai proxy same-origin (Vite dev / reverse proxy).
CORS_ORIGINS=
SESSION_DAYS=30
# sandbox = tombol "Bayar" uji di aplikasi. webhook = hanya konfirmasi dari payment gateway (POST /api/billing/webhook).
PAYMENT_PROVIDER=sandbox
# Rahasia HMAC-SHA256 untuk memverifikasi webhook gateway (wajib di produksi).
PAYMENT_WEBHOOK_SECRET=

# Token admin katalog (halaman /admin + CLI Hermes). WAJIB ≥ 24 karakter acak; kosong = API admin mati.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=
