# Disalin otomatis ke dist/ oleh Vite setiap build, jadi tidak hilang saat deploy/pull.
# Fallback SPA: semua rute React (mis. /try-on/3, /tentang) dibuka lewat index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # API katalog PHP (public/api/index.php): /api/*, /media/*, /admin → satu pintu. Authorization diteruskan ke PHP.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^(api/(?!index\.php$|admin\.html$)|media/|admin/?$) api/index.php [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Tipe berkas model 3D & kompresi (Apache bisa menolak/salah menyajikan ekstensi yang tak dikenal).
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType application/wasm .wasm
  AddType application/octet-stream .task .tflite
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(glb|gltf|wasm|task|tflite|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
# Keamanan dasar + kompresi + cache. Aman dilewati bila modul tidak aktif.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Kamera dipakai Coba Virtual (hanya situs ini); mikrofon dan lokasi tidak dipakai.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  # Berkas build Vite (folder assets/) bernama hash → cache panjang diatur di assets/.htaccess.
  <FilesMatch "^(index\.html|version\.txt|katalog-update\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml model/gltf-binary
</IfModule>
Options -Indexes
